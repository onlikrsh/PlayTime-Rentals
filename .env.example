# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# Firebase web app config (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_APP_ID=your_app_id

# Server only: service account JSON on one line
# (Firebase console → Project settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Push notifications. Generate a key pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your_public_key
VAPID_PRIVATE_KEY=your_private_key
VAPID_SUBJECT=mailto:you@example.com

# Optional: a long random password so only Vercel's daily timer can trigger the morning summary
CRON_SECRET=
