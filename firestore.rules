rules_version = '2';

// Only admins (users listed in the `admins` collection) can read or write anything.
// The public website never talks to Firestore directly: it goes through /api,
// which uses the service account and only ever exposes dates and prices.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Lets the admin app check whether the signed-in user is an admin.
    // Admins are added by hand in the Firebase console, never from the app.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    match /{collection}/{id} {
      allow read, write: if collection != 'admins' && isAdmin();
    }
  }
}
